        <mxCell id="end" value="Selesai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e3f2d6;strokeColor=#70b03c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="1520" width="160" height="50" as="geometry" />
        </mxCell>

