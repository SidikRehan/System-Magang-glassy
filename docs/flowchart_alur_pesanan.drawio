<mxfile host="app.diagrams.net">
  <diagram id="flowchart" name="Flowchart Alur Pesanan">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Terminator / Process / Decision / IO / Document -->
        <mxCell id="start" value="Mulai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e3f2d6;strokeColor=#70b03c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Login (username &amp;amp; password)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d0" value="Login valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="180" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Admin Toko input pesanan &amp;amp; item kaca (ukuran, jenis, qty)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="230" y="300" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Sistem hitung luas &amp;amp; harga otomatis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="390" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Simpan sebagai draft?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="470" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3b" value="Simpan draft (dapat diedit kembali)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="540" y="485" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Kirim pesanan ke divisi produksi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="590" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Divisi produksi mengerjakan kaca (catat waktu mulai)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="670" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Kaca cacat?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="750" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5b" value="Catat komplain / revisi &amp;amp; simpan kaca sisa (scrap)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="540" y="765" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="Catat waktu selesai produksi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="870" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="Admin Gudang rilis barang &amp;amp; cetak surat jalan" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.2;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="950" width="200" height="60" as="geometry" />
        </mxCell>
