        </mxCell>
        <mxCell id="p9" value="Driver unggah bukti terima" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1b68b0;" vertex="1" parent="1">
          <mxGeometry x="240" y="1240" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Pembayaran COD?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
